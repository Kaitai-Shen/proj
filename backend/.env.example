# AI Tutor Video 后端配置示例。复制为 backend/.env 后按需修改；密钥仅存 .env，不入 Git。
HOST=127.0.0.1
PORT=8000

# SQLite 连接串（建议绝对路径，相对路径以启动 uvicorn 的工作目录解析）
DATABASE_URL=sqlite:///backend/data/app.db

# 产物根目录（request.json / lesson_plan.json / scenes/ / final.mp4）
ARTIFACT_ROOT=backend/data/artifacts

# LLM（DeepSeek OpenAI 兼容协议）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-REPLACE_WITH_YOUR_KEY
LLM_MODEL=deepseek-chat

# 渲染器：stub（无 manim，用 ffmpeg 造测试视频）| local（本机 python -m manim）| docker（受限容器）
RENDERER_MODE=stub
RENDER_TIMEOUT_SECONDS=300
MAX_RENDER_RETRIES=2

# 业务限额
MAX_VIDEO_DURATION=90
MAX_JOB_SECONDS=3600

# Worker
WORKER_ENABLED=true
WORKER_POLL_INTERVAL=2
